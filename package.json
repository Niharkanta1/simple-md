{
  "name": "simple-markdown",
  "productName": "Simple Markdown",
  "version": "1.0.0",
  "description": "A lightweight desktop Markdown viewer, editor and project manager.",
  "main": "./out/main/index.js",
  "author": "Simple Markdown",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "svelte-check --tsconfig ./tsconfig.web.json --threshold error",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node scripts/smoke-test.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist:portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "dist:zip": "npm run build && electron-builder --win zip --x64 --publish never",
    "dist": "npm run build && electron-builder --win portable zip --x64 --publish never"
  },
  "dependencies": {
    "ignore": "^6.0.2",
    "yauzl": "^3.2.0",
    "yazl": "^2.5.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.6",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "@lezer/highlight": "^1.2.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.2",
    "@types/node": "^22.10.1",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "dompurify": "^3.2.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "highlight.js": "^11.10.0",
    "jsdom": "^25.0.1",
    "marked": "^14.1.4",
    "marked-highlight": "^2.2.1",
    "mermaid": "^11.4.1",
    "playwright-core": "^1.49.0",
    "svelte": "^5.2.7",
    "svelte-check": "^4.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
